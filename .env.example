# Backend runtime variables. Keep real values out of Git.
MONGODB_URI=mongodb://127.0.0.1:27017/restaurantQR
PORT=5000

# Comma-separated production frontend origins allowed by the API.
FRONTEND_URL=http://localhost:5173

# Frontend build variable. Use /api with a reverse proxy, or the deployed API URL.
VITE_API_URL=/api

# Vite dev/preview proxy target.
VITE_API_PROXY_TARGET=http://localhost:5000